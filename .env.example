# Modelo de Variáveis de Ambiente
# PORT: 3032 (Portal Unificado completo) ou 3015 (substituto direto do SIGEM antigo no PM2)
PORT=3032
NODE_ENV=production
# APP_MODE=sigem # Descomente se quiser que a rota raiz '/' abra diretamente o SIGEM em vez do Hub Central

# MySQL (Carta de Serviços)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=carta_de_servico
DB_POOL_SIZE=50

# SQLite (SIGEM)
SQLITE_DB_PATH=./dados/enderecos_duque_de_caxias_v2.db

# Geocodificação Cartográfica (Google Maps Geocoding API - Opcional, mantida com segurança no servidor)
GOOGLE_MAPS_API_KEY=

# JWT & Admin
JWT_SECRET=sua_chave_secreta_aqui
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_NAME=Administrador Geral PMDC
ADMIN_ROLE=admin
SESSION_EXPIRATION_HOURS=8

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=exemplo@gmail.com
SMTP_PASS=senha_de_app
EMAIL_DESTINATARIO=exemplo@gmail.com
